# ==============================================================================
# HadithMisinfoBench Environment Configuration Example
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Provider API Keys & Settings
# ------------------------------------------------------------------------------
# Provider to use: "openai", "anthropic", or "ollama"
HMB_LLM_PROVIDER=openai

# Model identifiers:
# - OpenAI: gpt-4o-mini, gpt-4o, etc.
# - Anthropic: claude-3-haiku-20240307, claude-3-5-sonnet-20241022, etc.
# - Ollama: qwen2.5:7b, llama3.1:8b, etc.
HMB_LLM_MODEL=gpt-4o-mini
HMB_LLM_TEMPERATURE=0.0
HMB_LLM_MAX_TOKENS=512
HMB_LLM_RETRY_ATTEMPTS=3
HMB_LLM_RETRY_BASE_DELAY=1.0

# API Keys (required when using the respective provider)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama Configuration (when HMB_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ------------------------------------------------------------------------------
# Directory Paths (relative to project root or absolute)
# ------------------------------------------------------------------------------
HMB_DATA_DIR=data
HMB_RESULTS_DIR=results
HMB_INDICES_DIR=data/indices

# ------------------------------------------------------------------------------
# Retrieval Configuration
# ------------------------------------------------------------------------------
# HuggingFace dense embedding model (e.g. BAAI/bge-m3)
HMB_DENSE_MODEL=BAAI/bge-m3

# Default number of evidence passages to retrieve (top-k)
HMB_DEFAULT_K=5

# Text mode for evidence corpus indexing & retrieval:
# "arabic_only", "english_only", or "arabic_plus_english"
HMB_RETRIEVAL_TEXT_MODE=arabic_plus_english

# ------------------------------------------------------------------------------
# Benchmark Construction & Sampling
# ------------------------------------------------------------------------------
# Number of samples per class for Dataset A
HMB_N_AUTHENTIC=250
HMB_N_FABRICATED=250
HMB_SEED=42

# Dataset C (Social Media) sample size
HMB_DATASET_C_SAMPLE=100
